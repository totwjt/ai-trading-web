# ============================================================
# mcp-deploy 环境配置模板
# 复制为 .env 并填写实际值
# ============================================================

# 项目根目录（必填）- 用于定位 Dockerfile、docker-compose 等
PROJECT_ROOT=/path/to/ai-trading-web

# 部署配置文件（可选，默认 .env.deploy）
DEPLOY_ENV_FILE=.env.deploy

# Harbor 仓库地址（可从 .env.deploy 读取，也可在此覆盖）
# HARBOR_URL=192.168.66.26:8000
# HARBOR_PROJECT=wangjiangtao

# 生产服务器 SSH（可从 .env.deploy 读取，也可在此覆盖）
# SSH_HOST=192.168.66.226
# SSH_USER=wangjiangtao
# SSH_PORT=22
# SSH_KEY_PATH=~/.ssh/id_rsa

# 部署超时设置（秒）
SSH_TIMEOUT=30
BUILD_TIMEOUT=600
DEPLOY_TIMEOUT=300
