# ===== frontend build-time vars (docker compose build) =====
# Use relative path so browser requests are sent to same-domain Nginx.
VITE_API_URL=/
VITE_WS_URL=/

# ===== Harbor (docker-compose.prod.yml 和 deploy/build.sh 共用) =====
# HARBOR_URL=your-registry:port
# HARBOR_PROJECT=your-project
# HARBOR_USERNAME=your-username
# HARBOR_PASSWORD=your-password

# ===== PostgreSQL (被 docker-compose.yml/services/postgres 读取) =====
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=tushare_sync

# ===== backend runtime vars (container env) =====
# 开发环境示例地址（直接运行 python server.py 时）
# 如需覆盖，在 backend/.env 中设置
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tushare_sync
# 行情库仅用于 stock_daily / stock_adj_factor / index_daily / stock_basic
# MARKET_DATA_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/z_strategies
# MARKET_API=http://192.168.66.143:8099
# TRADING_EXTERNAL_API=http://192.168.66.143:8000
# USER_API=http://192.168.66.143:8001

# ===== 生产环境（Docker Compose） - 所有外部服务通过 host.docker.internal 访问 =====
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/tushare_sync
MARKET_DATA_DATABASE_URL=postgresql+asyncpg://user:password@host.docker.internal:5432/z_strategies
MARKET_API=http://192.168.66.143:8882
TRADING_EXTERNAL_API=http://host.docker.internal:8882
TRADING_TRADER_API=http://192.168.66.155:8003
TRADING_ORDER_API=http://192.168.66.135:8881
TRADING_RECORD_API=http://192.168.66.135:8881
USER_API=http://192.168.66.198:8001
