# ===== frontend build-time vars (docker compose build) =====
# Use relative path so browser requests are sent to same-domain Nginx.
VITE_API_URL=/
VITE_WS_URL=/

# ===== Harbor (docker-compose.prod.yml 和 deploy/build.sh 共用) =====
HARBOR_URL=192.168.66.26:8000
HARBOR_PROJECT=wangjiangtao
HARBOR_USERNAME=admin
HARBOR_PASSWORD=Harbor12345

# ===== PostgreSQL (被 docker-compose.yml/services/postgres 读取) =====
POSTGRES_USER=wangjiangtao
POSTGRES_PASSWORD=123456
POSTGRES_DB=tushare_sync

# ===== 生产服务器 SSH（deploy/build.sh 部署时使用） =====
SSH_HOST=192.168.66.26
SSH_USER=root
SSH_PASSWORD=vonstars

# ===== backend runtime vars (container env) =====
DATABASE_URL=postgresql+asyncpg://wangjiangtao:123456@postgres:5432/tushare_sync
MARKET_API=http://host.docker.internal:8882
TRADING_EXTERNAL_API=http://host.docker.internal:8882
TRADING_TRADER_API=http://host.docker.internal:8003
TRADING_ORDER_API=http://host.docker.internal:8881
TRADING_RECORD_API=http://host.docker.internal:8881
USER_API=http://host.docker.internal:8001
